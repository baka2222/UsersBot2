# ============================================================
#  Единый файл конфигурации проекта.
#  Скопируйте в файл ".env" и заполните значения.
#  ВНИМАНИЕ: .env содержит секреты — не публикуйте его.
# ============================================================

# --- Данные приложения Telegram (https://my.telegram.org) ---
# Это приложение «по умолчанию». Дополнительные приложения можно завести прямо
# в панели (раздел «Главные аккаунты») и распределить по ним аккаунты — так ниже
# риск блокировок. Аккаунт без выбранного приложения берёт значения отсюда.
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=

# --- Настройки Django ---
# Длинная случайная строка. Сгенерировать:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Локально можно True; в Docker переопределяется на False автоматически
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Адреса, по которым открываете панель (важно при DEBUG=False; со схемой и портом)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- База данных ---
# Пусто = SQLite (локальная разработка без Docker).
# В Docker строка к PostgreSQL формируется автоматически из POSTGRES_* ниже.
DATABASE_URL=

# --- PostgreSQL (используется в Docker) ---
POSTGRES_USER=simulator
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=simulator
# Порт для доступа к базе с хоста (psql/DBeaver), не обязателен для работы.
# Если на машине есть другие такие же проекты (Postgres в Docker) — выберите
# для каждого свой порт, чтобы не столкнуться (5432 обычно занят локальным Postgres).
POSTGRES_HOST_PORT=5434

# --- Порт, на котором панель доступна снаружи (через Nginx) ---
# Если на машине уже работает другой проект на порту 80/8080 — смените здесь.
WEB_PORT=8080

# --- Автосоздание администратора при первом запуске ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me-strong-password
DJANGO_SUPERUSER_EMAIL=admin@example.com

# --- Часовой пояс и язык панели ---
TIME_ZONE=Europe/Moscow
LANGUAGE_CODE=ru-ru

# --- Поведение фонового процесса ---
WORKER_AUTOJOIN=True

# ============================================================
#  Защита аккаунтов от блокировок и обрывов связи
#  Значения по умолчанию уже безопасны — менять НЕ обязательно.
# ============================================================
# Флуд-лимиты Telegram короче этого порога (сек) бот пережидает сам,
# не роняя отправку и не «долбя» сервер повторами (60–300 разумно).
TELEGRAM_FLOOD_SLEEP_THRESHOLD=120
# Живучесть соединения: число переподключений и пауза между ними (сек).
TELEGRAM_CONNECTION_RETRIES=5
TELEGRAM_RETRY_DELAY=2
TELEGRAM_REQUEST_RETRIES=5
# Язык, которым «представляется» клиент (пусто = из LANGUAGE_CODE выше).
# TELEGRAM_DEVICE_LANG=ru

# --- Необязательный SOCKS5-прокси ---
# Если аккаунтов много, не гоняйте десятки сессий с одного IP: укажите прокси
# (нужен пакет PySocks: pip install PySocks). Пустой host = без прокси.
TELEGRAM_PROXY_HOST=
TELEGRAM_PROXY_PORT=1080
TELEGRAM_PROXY_USER=
TELEGRAM_PROXY_PASS=
